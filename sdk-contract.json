{
  "contractVersion": "1.0.0",
  "status": "frozen",
  "endpoint": "wss://api.voicelibrary.co/enterprise/v1/text-to-dialogue/websocket/multi",
  "authentication": {
    "header": "api-key",
    "persist": false,
    "log": false
  },
  "fixedQuery": {
    "priority": "dedicated_concurrency",
    "model_id": "myvocal_v3"
  },
  "options": {
    "format": {
      "default": "mp3_128",
      "values": [
        "mp3_64",
        "mp3_96",
        "mp3_128",
        "mp3_192",
        "pcm_8000",
        "pcm_16000",
        "pcm_22050",
        "pcm_24000",
        "pcm_44100",
        "ulaw_8000"
      ]
    },
    "language_code": {
      "default": null,
      "pattern": "^[A-Za-z]{2}$",
      "serialize": "lowercase"
    },
    "timestamps": {
      "default": false
    },
    "text_normalization": {
      "default": "on",
      "values": [
        "auto",
        "on",
        "off"
      ]
    },
    "seed": {
      "default": null,
      "minimum": 1,
      "maximum": 4294967295
    },
    "enable_logging": {
      "default": true
    }
  },
  "limits": {
    "activeContexts": 5,
    "voicesPerContext": {
      "minimum": 1,
      "maximum": 10
    },
    "stability": {
      "minimum": 0,
      "maximum": 1
    },
    "contextIdleSeconds": 20
  },
  "clientTextFramesOnly": true,
  "defensiveServerBinaryJson": true,
  "audioEncoding": "base64",
  "operations": [
    "connect",
    "open_context",
    "send_inputs",
    "flush",
    "keep_alive",
    "close_context",
    "close_socket",
    "abort"
  ],
  "events": [
    "audio",
    "is_final_audio_for_turn",
    "is_final",
    "alignment",
    "normalized_alignment",
    "error",
    "close"
  ],
  "contextSuccess": {
    "required": [
      "is_final"
    ],
    "forbidden": [
      "sticky_terminal_error"
    ]
  },
  "socketSuccess": {
    "required": [
      "all_active_contexts_final",
      "close_code_1000"
    ],
    "forbidden": [
      "sticky_terminal_error"
    ]
  },
  "errorCategories": [
    "ValidationError",
    "AuthenticationError",
    "StateError",
    "ProtocolError",
    "TransportError",
    "TimeoutError",
    "CallbackError"
  ],
  "automaticReplay": false,
  "activeSessionReconnect": false,
  "audioControlQueue": false,
  "audioAccumulationDefault": false,
  "excludedCapabilities": [
    "arbitrary_model_selection",
    "arbitrary_priority_selection"
  ],
  "runtimes": {
    "python": ">=3.9",
    "javaBytecodeMajor": 52,
    "javaTestVersions": [
      8,
      11,
      17,
      21,
      25
    ],
    "go": ">=1.22"
  },
  "license": "Apache-2.0"
}

{
  "contractVersion": "1.1.1",
  "endpoint": "wss://api.voicelibrary.co/enterprise/v1/text-to-dialogue/websocket/multi",
  "authentication": {
    "header": "api-key"
  },
  "fixedQuery": {
    "priority": "dedicated_concurrency"
  },
  "options": {
    "format": {
      "default": "mp3_128",
      "values": [
        "mp3_64",
        "mp3_96",
        "mp3_128",
        "mp3_192",
        "pcm_8000",
        "pcm_16000",
        "pcm_22050",
        "pcm_24000",
        "pcm_44100",
        "ulaw_8000"
      ]
    },
    "language_code": {
      "default": null,
      "pattern": "^[A-Za-z]{2}$"
    },
    "timestamps": {
      "default": false
    },
    "text_normalization": {
      "default": "on",
      "values": [
        "auto",
        "on",
        "off"
      ]
    },
    "seed": {
      "default": null,
      "minimum": 1,
      "maximum": 4294967295
    },
    "enable_logging": {
      "default": true
    },
    "model_id": {
      "default": "myvocal_v3",
      "knownModels": [
        "myvocal_v3",
        "myvocal_v4",
        "myvocal_v3_turbo"
      ]
    }
  },
  "limits": {
    "activeContexts": 5,
    "voicesPerContext": {
      "minimum": 1,
      "maximum": 10
    },
    "stability": {
      "minimum": 0,
      "maximum": 1
    },
    "contextIdleSeconds": 20
  },
  "audioEncoding": "base64",
  "operations": [
    "connect",
    "open_context",
    "send_inputs",
    "flush",
    "keep_alive",
    "close_context",
    "close_socket",
    "abort"
  ],
  "events": [
    "audio",
    "is_final_audio_for_turn",
    "is_final",
    "alignment",
    "normalized_alignment",
    "error",
    "close"
  ],
  "contextSuccess": {
    "required": [
      "is_final"
    ],
    "withoutErrors": true
  },
  "socketSuccess": {
    "required": [
      "all_active_contexts_final",
      "close_code_1000"
    ],
    "withoutErrors": true
  },
  "errorCategories": [
    "ValidationError",
    "AuthenticationError",
    "StateError",
    "ProtocolError",
    "TransportError",
    "TimeoutError",
    "CallbackError"
  ],
  "automaticReplay": false,
  "activeSessionReconnect": false,
  "audioAccumulationDefault": false,
  "runtimes": {
    "python": ">=3.9",
    "java": ">=8",
    "go": ">=1.22"
  },
  "license": "Apache-2.0"
}
